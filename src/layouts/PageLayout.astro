---
import BaseLayout from './BaseLayout.astro';
const { frontmatter } = Astro.props;
---

<BaseLayout title={frontmatter.title} description={frontmatter.description}>
  <div class="wrap">
    <header class="page-head">
      <h1 class="serif page-title">{frontmatter.title}</h1>
      {frontmatter.description && <p class="page-lead">{frontmatter.description}</p>}
    </header>
    <div class="prose">
      <slot />
    </div>
  </div>
</BaseLayout>
