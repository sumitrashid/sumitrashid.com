---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found">
  <div class="wrap">
    <header class="page-head">
      <h1 class="serif page-title">Page not found</h1>
      <p class="page-lead">The page you were looking for is not here. It may have moved, or the address may have a typo.</p>
    </header>
    <p style="padding-bottom: 96px"><a href="/" class="label link-arrow">Return to the homepage</a></p>
  </div>
</BaseLayout>
